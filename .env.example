# Deployment region: "global" (default) or "cn"
DEPLOYMENT_TARGET=global

# Set to use a real PostgreSQL instance; leave unset to use embedded PGlite
# (local dev, data stored in apps/web/.pglite-data)
# DATABASE_URL=postgres://user:pass@host:5432/db

# Optional: pin the embedded migrations dir (defaults to auto-discovery)
# MIGRATIONS_DIR=

# Optional: override the PGlite data directory
# PGLITE_DATA_DIR=

# Social login (global only; enabled only when both values exist)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# CN SMS provider (phone login adapter, cn deployment)
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
