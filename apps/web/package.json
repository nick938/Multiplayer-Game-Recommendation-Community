{
  "name": "@mgc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @mgc/db embed && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:worker": "pnpm --filter @mgc/db embed && opennextjs-cloudflare build",
    "preview:worker": "pnpm build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "pnpm build:worker && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@mgc/auth": "workspace:*",
    "@mgc/config": "workspace:*",
    "@mgc/db": "workspace:*",
    "@mgc/domain": "workspace:*",
    "@mgc/recommendation": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}
